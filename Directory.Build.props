<Project>
  <PropertyGroup>
    <!-- Override with -p:DvInstallDir=... when the game lives elsewhere. -->
    <DvInstallDir Condition="'$(DvInstallDir)' == ''">$(HOME)/.local/share/Steam/steamapps/common/Derail Valley</DvInstallDir>
    <DvManagedDir>$(DvInstallDir)/DerailValley_Data/Managed</DvManagedDir>
    <DvModManagerDir>$(DvManagedDir)/UnityModManager</DvModManagerDir>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
  <!-- Published assemblies must not carry local paths (the debug-symbol path
       names the build machine's home folder). -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <PathMap>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)'))=/RealisticFiring/</PathMap>
  </PropertyGroup>

</Project>
