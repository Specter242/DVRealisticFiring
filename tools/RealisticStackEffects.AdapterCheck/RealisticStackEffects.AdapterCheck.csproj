<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Contract check of Realistic Stack Effects' stock source against the
    installed game's assemblies, run under Mono by scripts/check-adapter.sh.
    Game assemblies are copied to bin/ (gitignored) so Mono can load them;
    nothing here touches Unity's native side.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/RealisticStackEffects/RealisticStackEffects.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="0Harmony" HintPath="$(DvModManagerDir)/0Harmony.dll" />
    <Reference Include="UnityModManager" HintPath="$(DvModManagerDir)/UnityModManager.dll" />
    <Reference Include="Assembly-CSharp" HintPath="$(DvManagedDir)/Assembly-CSharp.dll" />
    <Reference Include="DV.Simulation" HintPath="$(DvManagedDir)/DV.Simulation.dll" />
    <Reference Include="DV.Utils" HintPath="$(DvManagedDir)/DV.Utils.dll" />
    <Reference Include="UnityEngine" HintPath="$(DvManagedDir)/UnityEngine.dll" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(DvManagedDir)/UnityEngine.CoreModule.dll" />
  </ItemGroup>

</Project>
