<Project Sdk="Microsoft.NET.Sdk">

  <!-- Loaded by Realistic Firing only when Realistic Stack Effects runs: feeds it the realistic fires. -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>RealisticFiring.StackEffects</AssemblyName>
    <RootNamespace>RealisticFiring.StackEffects</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <!-- Both mods ship their own assemblies; neither is copied here. -->
  <ItemGroup>
    <ProjectReference Include="../RealisticFiring/RealisticFiring.csproj" Private="false" />
    <ProjectReference Include="../RealisticStackEffects/RealisticStackEffects.csproj" Private="false" />
  </ItemGroup>

  <!-- Game and loader assemblies are referenced in place and never copied. -->
  <ItemGroup>
    <Reference Include="UnityModManager" HintPath="$(DvModManagerDir)/UnityModManager.dll" Private="false" />
    <Reference Include="Assembly-CSharp" HintPath="$(DvManagedDir)/Assembly-CSharp.dll" Private="false" />
    <Reference Include="DV.Simulation" HintPath="$(DvManagedDir)/DV.Simulation.dll" Private="false" />
    <Reference Include="UnityEngine" HintPath="$(DvManagedDir)/UnityEngine.dll" Private="false" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(DvManagedDir)/UnityEngine.CoreModule.dll" Private="false" />
  </ItemGroup>

</Project>
