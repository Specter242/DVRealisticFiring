<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>RealisticStackEffects</AssemblyName>
    <RootNamespace>RealisticStackEffects</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../RealisticStackEffects.Core/RealisticStackEffects.Core.csproj" />
  </ItemGroup>

  <!-- The chimney plume, shared with Realistic Firing. -->
  <ItemGroup>
    <Compile Include="../RealisticStackEffects.Shared/Plume/*.cs" Link="Shared/%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- Game and loader assemblies are referenced in place and never copied. -->
  <ItemGroup>
    <Reference Include="0Harmony" HintPath="$(DvModManagerDir)/0Harmony.dll" Private="false" />
    <Reference Include="UnityModManager" HintPath="$(DvModManagerDir)/UnityModManager.dll" Private="false" />
    <Reference Include="Assembly-CSharp" HintPath="$(DvManagedDir)/Assembly-CSharp.dll" Private="false" />
    <Reference Include="DV.Simulation" HintPath="$(DvManagedDir)/DV.Simulation.dll" Private="false" />
    <Reference Include="DV.ThingTypes" HintPath="$(DvManagedDir)/DV.ThingTypes.dll" Private="false" />
    <Reference Include="DV.Utils" HintPath="$(DvManagedDir)/DV.Utils.dll" Private="false" />
    <Reference Include="DV.WeatherSystem" HintPath="$(DvManagedDir)/DV.WeatherSystem.dll" Private="false" />
    <Reference Include="DV.RailTrack" HintPath="$(DvManagedDir)/DV.RailTrack.dll" Private="false" />
    <Reference Include="DV.PointSet" HintPath="$(DvManagedDir)/DV.PointSet.dll" Private="false" />
    <Reference Include="BezierCurves" HintPath="$(DvManagedDir)/BezierCurves.dll" Private="false" />
    <Reference Include="Newtonsoft.Json" HintPath="$(DvManagedDir)/Newtonsoft.Json.dll" Private="false" />
    <Reference Include="WorldStreamer" HintPath="$(DvManagedDir)/WorldStreamer.dll" Private="false" />
    <Reference Include="UnityEngine" HintPath="$(DvManagedDir)/UnityEngine.dll" Private="false" />
    <Reference Include="UnityEngine.AssetBundleModule" HintPath="$(DvManagedDir)/UnityEngine.AssetBundleModule.dll" Private="false" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(DvManagedDir)/UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="UnityEngine.IMGUIModule" HintPath="$(DvManagedDir)/UnityEngine.IMGUIModule.dll" Private="false" />
    <Reference Include="UnityEngine.ImageConversionModule" HintPath="$(DvManagedDir)/UnityEngine.ImageConversionModule.dll" Private="false" />
    <Reference Include="UnityEngine.ParticleSystemModule" HintPath="$(DvManagedDir)/UnityEngine.ParticleSystemModule.dll" Private="false" />
    <Reference Include="UnityEngine.PhysicsModule" HintPath="$(DvManagedDir)/UnityEngine.PhysicsModule.dll" Private="false" />
    <Reference Include="UnityEngine.ScreenCaptureModule" HintPath="$(DvManagedDir)/UnityEngine.ScreenCaptureModule.dll" Private="false" />
    <Reference Include="UnityEngine.TextRenderingModule" HintPath="$(DvManagedDir)/UnityEngine.TextRenderingModule.dll" Private="false" />
    <Reference Include="UnityEngine.VRModule" HintPath="$(DvManagedDir)/UnityEngine.VRModule.dll" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Info.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
